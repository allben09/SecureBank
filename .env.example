# ========== DATABASE ==========
DB_USER=securebank_user
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=securebank

# ========== SECURITY ==========
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64
SESSION_SECRET=CHANGE_ME_RANDOM_STRING

# ========== API KEYS ==========
SNYK_TOKEN=your_snyk_token
GITHUB_TOKEN=your_github_token

# ========== SERVICES ==========
NODEJS_PORT=3000
GO_PORT=8080
PYTHON_PORT=8000
RUST_PORT=8001

# ========== FEATURES ==========
ENABLE_MFA=true
ENABLE_THREAT_DETECTION=true
ENABLE_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true

# ========== LOGGING ==========
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# ========== MONITORING ==========
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
